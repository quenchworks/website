---
/**
 * Shared catalog browser used by the charts + images index and the static
 * paginated /page/[n] routes. Renders the header, instant-search box, tier/
 * category (and, for images, status) filter controls, the SERVER-RENDERED
 * 12-card slice for the current page, and a real <a href> pager (Pager.astro).
 *
 * Filter/search is layered on top WITHOUT fake pagination: the full lightweight
 * dataset is embedded as JSON. When a query or a non-"All" filter is active, the
 * client hides the server slice + the real pager and renders ALL matching cards
 * into a results grid (the whole matching set, not a slice). Cleared back to All
 * + empty query restores the server slice + the real pager (visibility toggle,
 * no reload). The only URL-based pagination on the site is the real Pager.
 */
import Pager from './Pager.astro';
import type { AhFacts } from '../data/artifacthub';
import CveStatus from '../components/CveStatus.astro';
import { canonicalVersions } from '../data/images';
import { getLangFromUrl, localizeUrl, useTranslations } from '../i18n/ui';
import { localizedSummary } from '../i18n/content';
import { categoryName } from '../i18n/categories';
import { cardSummary } from '../data/truncate';

type ArtifactHubMap = Record<string, AhFacts>;

export type CatalogKind = 'charts' | 'images';

interface Slice {
  /** The 12 (or fewer on the last page) entries for the current page. */
  data: any[];
  current: number;
  total: number;
}

interface Props {
  kind: CatalogKind;
  /** Base path with no trailing slash, e.g. "/charts". */
  base: string;
  /** Full sorted entry list (for the embedded client dataset). */
  all: any[];
  /** Live ArtifactHub facts keyed by slug. */
  ah: ArtifactHubMap;
  /** The current page slice + page numbers. */
  page: Slice;
  /** Total catalog count shown in the header badge. */
  count: number;
  /** Sorted category list for the filter row. */
  categories: string[];
  /** Tier filters: [{ key, label }]. */
  tierFilters: { key: string; label: string }[];
  /** Same page size as the server-rendered pager (images.ts / charts.ts PAGE_SIZE), so the client-side filtered/paginated grid matches it exactly. */
  pageSize: number;
}

const { kind, base, all, ah, page, count, categories, tierFilters, pageSize } = Astro.props;

const isImages = kind === 'images';
const noun = isImages ? 'images' : 'charts';
const inputId = isImages ? 'image-search' : 'chart-search';
const listboxId = `${inputId}-suggest`;

// Keep links in the active locale: detail cards -> /<lang>/<noun>/<slug>, and the
// pager base -> /<lang>/<base>. The client renderer gets the prefix via a data attr.
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const headerTitle = isImages ? t('catalog.list.headerImages') : t('catalog.list.headerCharts');
const headerType = isImages ? t('catalog.list.typeImages') : t('catalog.list.typeCharts');
const itemBase = localizeUrl(lang, `/${noun}`);
const pagerBase = localizeUrl(lang, base);

// Lightweight dataset embedded for client-side filtering across the WHOLE
// catalog (small: a handful of string fields per entry).
// Canonical versions for an image entry (semver order, alias tags dropped).
const canon = (e: any) => canonicalVersions(e.versions);

const dataset = all.map((e) => {
  const live = ah[e.slug];
  const version = isImages
    ? (live?.appVersion ?? e.version ?? null)
    : (live?.version ?? e.chartVersion ?? null);
  return {
    slug: e.slug,
    name: e.name,
    category: e.category,
    categoryLabel: categoryName(lang, e.category),
    tier: e.tier,
    license: e.license,
    status: e.status ?? 'available',
    summary: localizedSummary(lang, kind, e.slug, e.summary),
    version,
    caution: !!e.caution,
    // images only: newest canonical tag (semver, alias tags dropped), its size,
    // and how many canonical tags exist.
    latest: isImages ? (canon(e)[0]?.version ?? null) : null,
    size: isImages ? (canon(e)[0]?.size ?? null) : null,
    versionCount: isImages ? canon(e).length : 0,
    // Trivy scan marker (security.json): total + grade/score/fixable for the badge.
    cveTotal: live?.securityTotal ?? null,
    cveGrade: live?.security?.grade ?? null,
    cveScore: live?.security?.score ?? null,
    cveFixable: live?.security?.fixable ?? null,
  };
});

// Card class helpers reused by server slice + client renderer (kept in sync via
// a data attribute the script reads).
---

<header class="max-w-2xl" data-pagefind-body data-pagefind-meta={`title:${headerTitle},type:${headerType}`}>
  <div class="flex flex-wrap items-center gap-3">
    <p class="font-mono text-xs uppercase tracking-widest text-ash">{headerType}</p>
    <span class="inline-flex items-center gap-1.5 rounded-full border border-line bg-graphite px-3 py-1 font-mono text-xs uppercase tracking-widest text-ash">
      <span class="text-base font-bold tabular-nums text-paper">{count}</span> {noun}
    </span>
  </div>
  {isImages ? (
    <>
      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">{t('catalog.list.titleImages')}</h1>
      <p class="mt-4 leading-relaxed text-ash">
        {t('catalog.list.descImages')} {count} {t('catalog.list.descImagesAvailable')}
      </p>
    </>
  ) : (
    <>
      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">{t('catalog.list.titleCharts')}</h1>
      <p class="mt-4 leading-relaxed text-ash">
        {t('catalog.list.descCharts')} {count} {t('catalog.list.descChartsCount')}
      </p>
    </>
  )}
</header>

<div class="relative mt-8">
  <label for={inputId} class="sr-only">{isImages ? t('catalog.list.searchImages') : t('catalog.list.searchCharts')}</label>
  <svg
    class="pointer-events-none absolute start-3.5 top-1/2 size-4 -translate-y-1/2 text-ash"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="11" cy="11" r="7"></circle>
    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
  </svg>
  {/* ARIA 1.2 combobox: the input owns the popup, the popup is a listbox of
      options, and the highlighted option is pointed at by aria-activedescendant
      (set by the script) so DOM focus never leaves the input. */}
  <input
    id={inputId}
    type="search"
    placeholder={t('catalog.list.searchPlaceholder')}
    autocomplete="off"
    autocorrect="off"
    autocapitalize="off"
    spellcheck={false}
    role="combobox"
    aria-expanded="false"
    aria-controls={listboxId}
    aria-autocomplete="list"
    class="w-full rounded-lg border border-line bg-graphite py-2.5 ps-10 pe-4 font-mono text-sm text-paper placeholder:text-ash focus:border-paper/40 focus:outline-none"
  />
  {/* Suggestions popup. Options are real <a href> (middle-click / open-in-new-tab
      still work) carrying role="option" + tabindex="-1", so they are exposed as
      listbox options rather than as a second tab stop. Border + tonal step for
      separation, never a shadow (DESIGN.md, The Border-Not-Shadow Rule). */}
  <div
    id={listboxId}
    role="listbox"
    aria-label={t('catalog.list.suggestions')}
    class="absolute inset-x-0 top-full z-30 mt-2 hidden max-h-80 overflow-y-auto rounded-xl border border-line bg-graphite p-1.5"
  >
  </div>
</div>

<div class="mb-8 mt-4 flex flex-wrap gap-2" role="group" aria-label={isImages ? t('catalog.list.filterImages') : t('catalog.list.filterCharts')}>
  <button
    data-filter="all"
    data-kind="all"
    class="filter-btn rounded-lg border border-line px-3.5 py-1.5 font-mono text-xs uppercase tracking-widest text-ash transition-colors duration-200 hover:border-paper/40 hover:text-paper aria-pressed:border-paper aria-pressed:bg-paper aria-pressed:text-ink"
    aria-pressed="true">{t('catalog.list.filterAll')}</button>
  {isImages && (
    <button
      data-filter="available"
      data-kind="status"
      class="filter-btn rounded-lg border border-line px-3.5 py-1.5 font-mono text-xs uppercase tracking-widest text-ash transition-colors duration-200 hover:border-paper/40 hover:text-paper aria-pressed:border-paper aria-pressed:bg-paper aria-pressed:text-ink"
      aria-pressed="false">{t('catalog.list.filterAvailable')}</button>
  )}
  {tierFilters.map((f) => (
    <button
      data-filter={f.key}
      data-kind="tier"
      class="filter-btn rounded-lg border border-line px-3.5 py-1.5 font-mono text-xs uppercase tracking-widest text-ash transition-colors duration-200 hover:border-paper/40 hover:text-paper aria-pressed:border-paper aria-pressed:bg-paper aria-pressed:text-ink"
      aria-pressed="false">{f.label}</button>
  ))}
  {/* 28-35 categories is a button wall; a native select stays scannable and gets
      the OS picker + keyboard for free. Tier/status stay as buttons (only a few). */}
  <label for="cat-filter" class="sr-only">{isImages ? t('catalog.list.filterImages') : t('catalog.list.filterCharts')}</label>
  <select
    id="cat-filter"
    class="rounded-lg border border-line bg-graphite px-3 py-1.5 font-mono text-xs uppercase tracking-widest text-ash transition-colors duration-200 hover:border-paper/40 focus:border-paper/40 focus:outline-none"
  >
    <option value="">{t('catalog.list.filterCategory')}</option>
    {categories.map((c) => (
      <option value={c}>{categoryName(lang, c)}</option>
    ))}
  </select>
</div>

<div class="mb-4 flex min-h-5 flex-wrap items-center justify-between gap-4">
  {/* role="status" (implicit aria-live="polite") so the match count is announced
      when typing/filtering changes it, instead of updating silently. */}
  <p class="font-mono text-xs uppercase tracking-widest text-ash" id="result-count" role="status"></p>
  <p class="hidden flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-ash" id="no-results">
    <span>{isImages ? t('catalog.list.noMatchImages') : t('catalog.list.noMatchCharts')}</span>
    <button type="button" id="clear-filters" class="rounded border border-line px-2 py-0.5 text-ash transition-colors duration-200 hover:border-paper/40 hover:text-paper">{t('catalog.list.clearFilters')}</button>
  </p>
</div>

{/* SERVER slice: the real, crawlable 12-card page. Hidden by the client when filtering. */}
<ul id="server-grid" class="grid auto-rows-fr grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
  {page.data.map((e, i) => {
    const live = ah[e.slug];
    if (isImages) {
      const Tag = e.status === 'available' ? 'a' : 'div';
      const cv = canon(e);
      const latest = cv[0]?.version ?? live?.appVersion ?? e.version;
      const size = cv[0]?.size;
      const count = cv.length;
      return (
        <li class="card" data-reveal style={`--i:${i}`} data-status={e.status} data-tier={e.tier} data-category={e.category}>
          <Tag
            {...(e.status === 'available' ? { href: `${itemBase}/${e.slug}` } : {})}
            class:list={[
              'group flex h-full flex-col gap-4 rounded-xl border bg-graphite p-5 transition-colors duration-200',
              e.status === 'available' ? 'border-line hover:border-paper/40' : 'border-line/70 bg-graphite/50',
            ]}
          >
            <div class="flex items-start justify-between gap-3">
              <span class="inline-flex size-10 items-center justify-center rounded-lg border border-line bg-ink">
                {e.status === 'available' ? (
                  <img src="/brand/icon-dark.svg" alt="" class="size-6" width="24" height="24" />
                ) : (
                  <span class="size-2 rounded-full border border-ash" aria-hidden="true" />
                )}
              </span>
              {e.status === 'available' ? (
                <CveStatus total={live?.securityTotal} sec={live?.security} cleanLabel="0 CVE" />
              ) : (
                <span class="rounded border border-line px-2 py-0.5 font-mono text-[10px] uppercase tracking-widest text-ash">{t('catalog.list.badgePlanned')}</span>
              )}
            </div>
            <div class="flex-1">
              <h2 class:list={['text-base font-semibold leading-tight', e.status === 'available' ? '' : 'text-paper/80']}>{e.name}</h2>
              <p class="mt-2 line-clamp-3 min-h-17 text-sm leading-relaxed text-ash">{cardSummary(localizedSummary(lang, kind, e.slug, e.summary))}</p>
            </div>
            {e.status === 'available' && latest && (
              <p class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[10px] uppercase tracking-widest text-ash">
                <span class="text-paper">v{latest}</span>
                {size && <><span class="text-line" aria-hidden="true">·</span><span class="tabular-nums">{size}</span></>}
                {count > 1 && <><span class="text-line" aria-hidden="true">·</span><span class="tabular-nums">{count} {t('catalog.list.versions')}</span></>}
              </p>
            )}
            <div class="flex flex-wrap gap-1.5 font-mono text-[10px] uppercase tracking-widest text-ash">
              <span class="rounded bg-ink px-2 py-0.5">{categoryName(lang, e.category)}</span>
              <span class="rounded bg-ink px-2 py-0.5">{e.tier}</span>
              <span class:list={['rounded bg-ink px-2 py-0.5', e.caution ? 'text-amber-400' : '']}>{e.license}</span>
            </div>
          </Tag>
        </li>
      );
    }
    const chartVer = live?.version ?? e.chartVersion;
    const appVer = live?.appVersion ?? e.appVersion;
    return (
      <li class="card" data-reveal style={`--i:${i}`} data-tier={e.tier} data-category={e.category}>
        <a
          href={`${itemBase}/${e.slug}`}
          class="group flex h-full flex-col gap-4 rounded-xl border border-line bg-graphite p-5 transition-colors duration-200 hover:border-paper/40"
        >
          <div class="flex items-start justify-between gap-3">
            <span class="inline-flex size-10 items-center justify-center rounded-lg border border-line bg-ink">
              <img src="/brand/icon-dark.svg" alt="" class="size-6" width="24" height="24" />
            </span>
            <CveStatus total={live?.securityTotal} sec={live?.security} cleanLabel="0 CVE" />
          </div>
          <div class="flex-1">
            <h2 class="text-base font-semibold leading-tight">{e.name}</h2>
            <p class="mt-2 line-clamp-3 min-h-17 text-sm leading-relaxed text-ash">{cardSummary(localizedSummary(lang, kind, e.slug, e.summary))}</p>
          </div>
          <p class="font-mono text-[10px] uppercase tracking-widest text-ash">
            {t('catalog.list.chartV')}{chartVer ?? '?'}{appVer ? ` · ${t('catalog.list.appV')}${appVer}` : ''}
          </p>
          <div class="flex flex-wrap gap-1.5 font-mono text-[10px] uppercase tracking-widest text-ash">
            <span class="rounded bg-ink px-2 py-0.5">{categoryName(lang, e.category)}</span>
            <span class="rounded bg-ink px-2 py-0.5">{e.tier}</span>
            <span class:list={['rounded bg-ink px-2 py-0.5', e.caution ? 'text-amber-400' : '']}>{e.license}</span>
          </div>
        </a>
      </li>
    );
  })}
</ul>

{/* CLIENT results: filled with the full matching set when filtering. Hidden otherwise. */}
<ul id="filter-grid" class="hidden grid auto-rows-fr grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3"></ul>

{/* CLIENT pager for the filtered set: same page size + button markup as Pager.astro
    below, rendered/hidden by the client script (real <a href> links, JS-intercepted
    for pushState). Empty + hidden until apply() has something to paginate. */}
<nav id="filter-pager" class="hidden mt-10 flex flex-wrap items-center justify-center gap-1.5" aria-label="Pagination"></nav>

<Pager base={pagerBase} current={page.current} total={page.total} />

<script
  is:inline
  id="catalog-data"
  type="application/json"
  data-kind={kind}
  data-itembase={itemBase}
  data-page-size={pageSize}
  data-planned={t('catalog.list.badgePlanned')}
  data-versions={t('catalog.list.versions')}
  data-chartv={t('catalog.list.chartV')}
  data-result-one={t('catalog.list.resultOne')}
  data-result-many={t('catalog.list.resultMany')}
  data-suggest={`/suggest/${lang}.json`}
  data-image-base={localizeUrl(lang, '/images')}
  data-chart-base={localizeUrl(lang, '/charts')}
  data-type-images={t('catalog.list.typeImages')}
  data-type-charts={t('catalog.list.typeCharts')}
  set:html={JSON.stringify(dataset)}
/>

<script>
  import { gradeTone, gradeNote, GRADE_CHIP } from '../data/grade';
  import { cardSummary } from '../data/truncate';
  import {
    rankSuggestions,
    suggestName,
    SUGGEST_MIN,
    type SuggestKind,
    type SuggestRow,
  } from '../data/suggest';

  type Entry = {
    slug: string;
    name: string;
    category: string;
    categoryLabel: string;
    tier: string;
    license: string;
    status: string;
    summary: string;
    version: string | null;
    caution: boolean;
    latest: string | null;
    size: string | null;
    versionCount: number;
  };

  const dataEl = document.getElementById('catalog-data');
  const kind = dataEl?.getAttribute('data-kind') ?? 'charts';
  const itemBase = dataEl?.getAttribute('data-itembase') ?? `/${kind}`;
  const tPlanned = dataEl?.getAttribute('data-planned') ?? 'Planned';
  const tVersions = dataEl?.getAttribute('data-versions') ?? 'versions';
  const tChartV = dataEl?.getAttribute('data-chartv') ?? 'chart v';
  const tResultOne = dataEl?.getAttribute('data-result-one') ?? 'result';
  const tResultMany = dataEl?.getAttribute('data-result-many') ?? 'results';
  const isImages = kind === 'images';
  const all: Entry[] = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
  // Same page size as the server-rendered Pager (images.ts / charts.ts PAGE_SIZE = 12),
  // passed through as a data attribute so the filtered/paginated grid matches it exactly.
  const PAGE_SIZE = Number(dataEl?.getAttribute('data-page-size')) || 12;

  const search = document.querySelector<HTMLInputElement>(isImages ? '#image-search' : '#chart-search');
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const catSelect = document.querySelector<HTMLSelectElement>('#cat-filter');
  const serverGrid = document.getElementById('server-grid');
  const filterGrid = document.getElementById('filter-grid');
  const filterPager = document.getElementById('filter-pager');
  const realPager = document.getElementById('real-pager');
  const noResults = document.getElementById('no-results');
  const count = document.getElementById('result-count');
  const clearFiltersBtn = document.getElementById('clear-filters');

  let activeFilter = 'all';
  let activeKind = 'all';
  let currentPage = 1;

  // --- URL as source of truth for q / status / tier / category / page ------
  // Buttons + the category select are one mutually-exclusive facet (see the
  // click handlers below), so at most one of status/tier/category is ever in
  // the URL alongside q. Priority on read mirrors that: status > tier > category.
  // Changing q/status/tier/category always resets page back to 1 (a stale page
  // number from a previous, larger result set would otherwise render blank).
  type UrlState = { q: string; kind: string; filter: string; page: number };

  function stateFromURL(): UrlState {
    const p = new URLSearchParams(location.search);
    const q = p.get('q') ?? '';
    const status = p.get('status');
    const tier = p.get('tier');
    const category = p.get('category');
    const rawPage = parseInt(p.get('page') ?? '1', 10);
    const page = Number.isFinite(rawPage) && rawPage > 0 ? rawPage : 1;
    if (isImages && status) return { q, kind: 'status', filter: status, page };
    if (tier) return { q, kind: 'tier', filter: tier, page };
    if (category) return { q, kind: 'category', filter: category, page };
    return { q, kind: 'all', filter: 'all', page };
  }

  // Reflect a state into the controls (search box, pressed buttons, select)
  // without touching the URL or history -- used on first load and popstate.
  // The page number itself has no control to sync; apply() renders + clamps it.
  function syncControls(state: UrlState) {
    activeKind = state.kind;
    activeFilter = state.filter;
    currentPage = state.page;
    if (search) search.value = state.q;
    buttons.forEach((b) => {
      const pressed = state.kind === 'all' ? b.dataset.filter === 'all' : b.dataset.kind === state.kind && b.dataset.filter === state.filter;
      b.setAttribute('aria-pressed', String(pressed));
    });
    if (catSelect) catSelect.value = state.kind === 'category' ? state.filter : '';
  }

  function currentState(): UrlState {
    return { q: (search?.value ?? '').trim(), kind: activeKind, filter: activeFilter, page: currentPage };
  }

  // Builds the URL for a state, dropping any param that's back to its default
  // (empty query, "all" facet, page 1) instead of leaving e.g. "?q=" or
  // "&page=1" behind.
  function buildURL(state: UrlState): string {
    const p = new URLSearchParams();
    if (state.q) p.set('q', state.q);
    if (state.kind === 'status') p.set('status', state.filter);
    else if (state.kind === 'tier') p.set('tier', state.filter);
    else if (state.kind === 'category') p.set('category', state.filter);
    if (state.page > 1) p.set('page', String(state.page));
    const qs = p.toString();
    return `${location.pathname}${qs ? `?${qs}` : ''}`;
  }

  function writeURL(state: UrlState, mode: 'push' | 'replace') {
    const url = buildURL(state);
    if (url === `${location.pathname}${location.search}`) return;
    if (mode === 'push') history.pushState(state, '', url);
    else history.replaceState(state, '', url);
  }

  const esc = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

  // Security badge (matches CveStatus.astro): leads with the Trivy grade (A+ clean →
  // F critical), count tags along. Colours come from the ONE shared map in
  // src/data/grade.ts so this client-side copy can never drift from the SSR one.
  const cveBadge = (e: Entry): string => {
    const tot = (e as any).cveTotal;
    const grade: string | null = (e as any).cveGrade;
    const fixable: number | null = (e as any).cveFixable;
    const has = typeof tot === 'number' && tot > 0;
    const g = grade ?? (typeof tot === 'number' ? (has ? null : 'A+') : null);
    const cls = GRADE_CHIP[gradeTone(g, has)];
    const label = g ? `${g}${has ? '&nbsp;' + tot : ''}` : (has ? `${tot}&nbsp;CVE${tot === 1 ? '' : 's'}` : '0&nbsp;CVE');
    const note = gradeNote(g);
    const title = esc(`Trivy scan: grade ${g ?? (has ? '–' : 'A+')}${has ? ` · ${tot} CVE${tot === 1 ? '' : 's'}` : ' · no CVEs'}${fixable ? ` · ${fixable} fixable` : ''}${note ? ` · ${note}` : ''}`);
    return `<span class="inline-flex items-center rounded border px-2 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-widest tabular-nums ${cls}" role="img" aria-label="${title}" title="${title}">${label}</span>`;
  };

  // Mirrors Pager.astro's markup/classes exactly (BTN_BASE/IDLE/ACTIVE/DISABLED,
  // the same delta-1 ellipsis page list, the same prev/next chevrons) so the
  // filtered grid's pager is visually identical to the real, server-rendered one.
  // Real <a href> links to the same page with ?page=N (deep-linkable / crawlable
  // / open-in-new-tab), intercepted by the click handler below for pushState nav.
  const PAGER_BTN_BASE = 'inline-flex min-h-9 min-w-9 items-center justify-center rounded-lg border px-3 py-1.5 font-mono text-xs uppercase tracking-widest transition-colors duration-200 focus-visible:outline-2';
  const PAGER_BTN_IDLE = 'border-line bg-graphite text-ash hover:border-paper/40 hover:text-paper';
  const PAGER_BTN_ACTIVE = 'border-paper bg-paper text-ink';
  const PAGER_BTN_DISABLED = 'border-line/60 bg-graphite/50 text-ash/40 cursor-not-allowed';
  const PAGER_PREV_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg>';
  const PAGER_NEXT_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>';

  type PageToken = number | 'ellipsis';

  function pageTokens(cur: number, tot: number, delta = 1): PageToken[] {
    if (tot <= 1) return [1];
    const pages = new Set<number>([1, tot]);
    for (let p = cur - delta; p <= cur + delta; p++) if (p >= 1 && p <= tot) pages.add(p);
    const sorted = [...pages].sort((a, b) => a - b);
    const out: PageToken[] = [];
    let prev = 0;
    for (const p of sorted) {
      if (p - prev > 1) out.push('ellipsis');
      out.push(p);
      prev = p;
    }
    return out;
  }

  function pagerHTML(cur: number, tot: number): string {
    if (tot <= 1) return '';
    const hrefFor = (p: number) => esc(buildURL({ ...currentState(), page: p }));
    const prevDisabled = cur <= 1;
    const nextDisabled = cur >= tot;
    const prev = prevDisabled
      ? `<span class="${PAGER_BTN_BASE} ${PAGER_BTN_DISABLED}" aria-disabled="true" aria-label="Previous page">${PAGER_PREV_SVG}</span>`
      : `<a href="${hrefFor(cur - 1)}" data-page="${cur - 1}" class="${PAGER_BTN_BASE} ${PAGER_BTN_IDLE}" aria-label="Previous page" rel="prev">${PAGER_PREV_SVG}</a>`;
    const next = nextDisabled
      ? `<span class="${PAGER_BTN_BASE} ${PAGER_BTN_DISABLED}" aria-disabled="true" aria-label="Next page">${PAGER_NEXT_SVG}</span>`
      : `<a href="${hrefFor(cur + 1)}" data-page="${cur + 1}" class="${PAGER_BTN_BASE} ${PAGER_BTN_IDLE}" aria-label="Next page" rel="next">${PAGER_NEXT_SVG}</a>`;
    const numbers = pageTokens(cur, tot)
      .map((tok) =>
        tok === 'ellipsis'
          ? `<span class="inline-flex min-h-9 min-w-9 items-center justify-center font-mono text-xs text-ash/70" aria-hidden="true">…</span>`
          : tok === cur
            ? `<span class="${PAGER_BTN_BASE} tabular-nums ${PAGER_BTN_ACTIVE}" aria-current="page" aria-label="Page ${tok}">${tok}</span>`
            : `<a href="${hrefFor(tok)}" data-page="${tok}" class="${PAGER_BTN_BASE} tabular-nums ${PAGER_BTN_IDLE}" aria-label="Page ${tok}">${tok}</a>`,
      )
      .join('');
    return `${prev}${numbers}${next}`;
  }

  function cardHTML(e: Entry): string {
    if (isImages) {
      const available = e.status === 'available';
      const tag = available ? 'a' : 'div';
      const href = available ? ` href="${itemBase}/${e.slug}"` : '';
      const cls = available
        ? 'group flex h-full flex-col gap-4 rounded-xl border bg-graphite p-5 transition-colors duration-200 border-line hover:border-paper/40'
        : 'group flex h-full flex-col gap-4 rounded-xl border bg-graphite p-5 transition-colors duration-200 border-line/70 bg-graphite/50';
      const icon = available
        ? '<img src="/brand/icon-dark.svg" alt="" class="size-6" width="24" height="24" />'
        : '<span class="size-2 rounded-full border border-ash" aria-hidden="true"></span>';
      const badge = available
        ? cveBadge(e)
        : `<span class="rounded border border-line px-2 py-0.5 font-mono text-[10px] uppercase tracking-widest text-ash">${esc(tPlanned)}</span>`;
      const latest = e.latest ?? e.version;
      const verParts = available && latest
        ? [`<span class="text-paper">v${esc(latest)}</span>`]
            .concat(e.size ? [`<span class="text-line">·</span><span class="tabular-nums">${esc(e.size)}</span>`] : [])
            .concat(e.versionCount > 1 ? [`<span class="text-line">·</span><span class="tabular-nums">${e.versionCount} ${esc(tVersions)}</span>`] : [])
        : [];
      const ver = verParts.length
        ? `<p class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[10px] uppercase tracking-widest text-ash">${verParts.join('')}</p>`
        : '';
      const h2cls = available ? 'text-base font-semibold leading-tight' : 'text-base font-semibold leading-tight text-paper/80';
      const licCls = e.caution ? 'rounded bg-ink px-2 py-0.5 text-amber-400' : 'rounded bg-ink px-2 py-0.5';
      return `<li class="card"><${tag}${href} class="${cls}">
        <div class="flex items-start justify-between gap-3">
          <span class="inline-flex size-10 items-center justify-center rounded-lg border border-line bg-ink">${icon}</span>
          ${badge}
        </div>
        <div class="flex-1">
          <h2 class="${h2cls}">${esc(e.name)}</h2>
          <p class="mt-2 line-clamp-3 min-h-17 text-sm leading-relaxed text-ash">${esc(cardSummary(e.summary))}</p>
        </div>
        ${ver}
        <div class="flex flex-wrap gap-1.5 font-mono text-[10px] uppercase tracking-widest text-ash">
          <span class="rounded bg-ink px-2 py-0.5">${esc(e.categoryLabel)}</span>
          <span class="rounded bg-ink px-2 py-0.5">${esc(e.tier)}</span>
          <span class="${licCls}">${esc(e.license)}</span>
        </div>
      </${tag}></li>`;
    }
    const licCls = e.caution ? 'rounded bg-ink px-2 py-0.5 text-amber-400' : 'rounded bg-ink px-2 py-0.5';
    const ver = e.version ? `${esc(tChartV)}${esc(e.version)}` : `${esc(tChartV)}?`;
    return `<li class="card"><a href="${itemBase}/${e.slug}" class="group flex h-full flex-col gap-4 rounded-xl border border-line bg-graphite p-5 transition-colors duration-200 hover:border-paper/40">
      <div class="flex items-start justify-between gap-3">
        <span class="inline-flex size-10 items-center justify-center rounded-lg border border-line bg-ink"><img src="/brand/icon-dark.svg" alt="" class="size-6" width="24" height="24" /></span>
        ${cveBadge(e)}
      </div>
      <div class="flex-1">
        <h2 class="text-base font-semibold leading-tight">${esc(e.name)}</h2>
        <p class="mt-2 line-clamp-3 min-h-17 text-sm leading-relaxed text-ash">${esc(cardSummary(e.summary))}</p>
      </div>
      <p class="font-mono text-[10px] uppercase tracking-widest text-ash">${ver}</p>
      <div class="flex flex-wrap gap-1.5 font-mono text-[10px] uppercase tracking-widest text-ash">
        <span class="rounded bg-ink px-2 py-0.5">${esc(e.categoryLabel)}</span>
        <span class="rounded bg-ink px-2 py-0.5">${esc(e.tier)}</span>
        <span class="${licCls}">${esc(e.license)}</span>
      </div>
    </a></li>`;
  }

  function isFiltering(q: string): boolean {
    return q !== '' || activeKind !== 'all';
  }

  function apply() {
    const q = (search?.value ?? '').trim().toLowerCase();

    if (!isFiltering(q)) {
      // Restore the real, server-rendered slice + the real URL pager.
      filterGrid?.classList.add('hidden');
      if (filterGrid) filterGrid.innerHTML = '';
      filterPager?.classList.add('hidden');
      if (filterPager) filterPager.innerHTML = '';
      serverGrid?.classList.remove('hidden');
      // Force-reveal any server card that never got its entrance (was display:none
      // while filtering, so the IntersectionObserver couldn't fire): no blank cells.
      serverGrid?.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-visible'));
      realPager?.classList.remove('hidden');
      noResults?.classList.add('hidden');
      if (count) count.textContent = '';
      return;
    }

    // Filtering: match across the whole catalog, then paginate the result set
    // at the same PAGE_SIZE as the server-rendered grid. Hide the server slice
    // and the real pager -- this is a separate, client-only paginated view.
    const matches = all.filter((e) => {
      const matchFilter =
        activeKind === 'all' ||
        (activeKind === 'status' && e.status === activeFilter) ||
        (activeKind === 'tier' && e.tier === activeFilter) ||
        (activeKind === 'category' && e.category === activeFilter);
      const haystack = `${e.name} ${e.category} ${e.license} ${e.summary}`.toLowerCase();
      const matchSearch = q === '' || haystack.includes(q);
      return matchFilter && matchSearch;
    });

    // Clamp a stale/out-of-range page (e.g. a deep link to page 9 of a set
    // that now only has 2 pages) to the last valid page instead of rendering blank.
    const totalPages = Math.max(1, Math.ceil(matches.length / PAGE_SIZE));
    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;
    const start = (currentPage - 1) * PAGE_SIZE;
    const pageMatches = matches.slice(start, start + PAGE_SIZE);

    serverGrid?.classList.add('hidden');
    realPager?.classList.add('hidden');
    if (filterGrid) {
      filterGrid.innerHTML = pageMatches.map(cardHTML).join('');
      filterGrid.classList.toggle('hidden', matches.length === 0);
    }
    noResults?.classList.toggle('hidden', matches.length !== 0);
    if (filterPager) {
      // No pager on the empty state (just the Clear-filters escape hatch), and
      // none at all when everything fits on one page.
      filterPager.innerHTML = matches.length === 0 ? '' : pagerHTML(currentPage, totalPages);
      filterPager.classList.toggle('hidden', matches.length === 0 || totalPages <= 1);
    }
    if (count) {
      const noun = matches.length === 1 ? tResultOne : tResultMany;
      count.textContent = matches.length === 0 ? '' : `${matches.length} ${noun}`;
    }
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      // Buttons and the category select are one mutually-exclusive dimension:
      // pressing a button clears the category select back to "All categories".
      if (catSelect) catSelect.value = '';
      activeFilter = btn.dataset.filter ?? 'all';
      activeKind = btn.dataset.kind ?? 'all';
      currentPage = 1; // a filter change always lands back on page 1
      apply();
      writeURL(currentState(), 'push');
    });
  });
  catSelect?.addEventListener('change', () => {
    if (catSelect.value) {
      activeKind = 'category';
      activeFilter = catSelect.value;
      buttons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
    } else {
      // Back to "All categories" == the All button.
      activeKind = 'all';
      activeFilter = 'all';
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === 'all')));
    }
    currentPage = 1; // a filter change always lands back on page 1
    apply();
    writeURL(currentState(), 'push');
  });
  clearFiltersBtn?.addEventListener('click', () => {
    const state: UrlState = { q: '', kind: 'all', filter: 'all', page: 1 };
    syncControls(state);
    apply();
    closeSuggest();
    writeURL(state, 'push');
  });

  // ── Suggestions (autocomplete) ─────────────────────────────────────────────
  // Layered ON TOP of the filtering above, which is untouched: typing still
  // filters the grid and still rewrites ?q= exactly as before. The popup is an
  // extra way OUT of this page — picking a suggestion navigates straight to that
  // item's detail page, and it spans BOTH kinds, so "redis" on /images also
  // offers the redis chart.
  //
  // The index is the build-time file at /suggest/<lang>.json
  // (src/pages/suggest/[lang].json.ts), fetched once on first use and then
  // browser-cached — deliberately NOT inlined, so no catalog page pays for it.
  // The row layout and the match ranking come from the ONE shared module in
  // src/data/suggest.ts (same trick as grade.ts above), so this client copy can
  // never drift from the index the endpoint emits.
  const suggestUrl = dataEl?.getAttribute('data-suggest') ?? '';
  // Indexed by row[0]: 0 = image, 1 = chart.
  const suggestBase = [
    dataEl?.getAttribute('data-image-base') ?? '/images',
    dataEl?.getAttribute('data-chart-base') ?? '/charts',
  ];
  const suggestKindLabel = [
    dataEl?.getAttribute('data-type-images') ?? 'Images',
    dataEl?.getAttribute('data-type-charts') ?? 'Charts',
  ];
  // Derived from the input itself so the markup stays the single source of truth.
  const listbox = document.getElementById(search?.getAttribute('aria-controls') ?? '');

  let suggestIndex: SuggestRow[] | null = null;
  let suggestFetch: Promise<SuggestRow[]> | null = null;
  let sgRows: SuggestRow[] = [];
  let sgActive = -1;

  function loadSuggestIndex(): Promise<SuggestRow[]> {
    if (suggestIndex) return Promise.resolve(suggestIndex);
    // A failed fetch degrades to "no suggestions"; the filter grid still works.
    suggestFetch ??= fetch(suggestUrl)
      .then((r) => (r.ok ? (r.json() as Promise<SuggestRow[]>) : []))
      .catch(() => [] as SuggestRow[])
      .then((rows) => (suggestIndex = Array.isArray(rows) ? rows : []));
    return suggestFetch;
  }

  function closeSuggest() {
    sgRows = [];
    sgActive = -1;
    search?.setAttribute('aria-expanded', 'false');
    search?.removeAttribute('aria-activedescendant');
    if (!listbox) return;
    listbox.classList.add('hidden');
    listbox.replaceChildren();
  }

  /** Move the VIRTUAL cursor: aria-activedescendant + the highlight class. */
  function markActive() {
    const opts = Array.from(listbox?.querySelectorAll<HTMLElement>('[role="option"]') ?? []);
    opts.forEach((el, i) => {
      const on = i === sgActive;
      el.setAttribute('aria-selected', String(on));
      el.classList.toggle('bg-ink', on);
      if (on) el.scrollIntoView({ block: 'nearest' });
    });
    const active = sgActive >= 0 ? opts[sgActive] : undefined;
    if (active) search?.setAttribute('aria-activedescendant', active.id);
    else search?.removeAttribute('aria-activedescendant');
  }

  function renderSuggest(q: string) {
    if (!listbox || !search || !suggestIndex) return;
    const here: SuggestKind = isImages ? 0 : 1;
    sgRows = rankSuggestions(suggestIndex, q, here);

    if (sgRows.length === 0) {
      closeSuggest();
      return;
    }
    listbox.innerHTML = sgRows
      .map(
        (r, i) => `<a id="${search.id}-opt-${i}" role="option" aria-selected="false" tabindex="-1"
        href="${esc(suggestBase[r[0]])}/${esc(r[1])}"
        class="flex flex-col gap-0.5 rounded-lg px-3 py-2 no-underline transition-colors duration-150 hover:bg-ink">
        <span class="flex items-center justify-between gap-3">
          <span class="text-sm font-medium text-paper">${esc(suggestName(r))}</span>
          <span class="shrink-0 rounded bg-ink px-2 py-0.5 font-mono text-[10px] uppercase tracking-widest text-ash">${esc(suggestKindLabel[r[0]])}</span>
        </span>
        <span class="line-clamp-1 text-xs leading-relaxed text-ash">${esc(r[3])} · ${esc(r[4])}</span>
      </a>`,
      )
      .join('');
    listbox.classList.remove('hidden');
    search.setAttribute('aria-expanded', 'true');
    sgActive = -1;
    markActive();
  }

  const suggestQuery = () => (search?.value ?? '').trim().toLowerCase();

  async function suggest() {
    if (!listbox || !suggestUrl) return;
    const q = suggestQuery();
    if (q.length < SUGGEST_MIN) {
      closeSuggest();
      return;
    }
    await loadSuggestIndex();
    // Another keystroke landed while the index was in flight: that call renders.
    if (suggestQuery() !== q) return;
    renderSuggest(q);
  }

  const suggestOpen = () => sgRows.length > 0 && listbox?.classList.contains('hidden') === false;

  // Warm the index on focus so the first keystroke has it in hand.
  search?.addEventListener('focus', () => {
    if (suggestUrl) void loadSuggestIndex();
  });

  search?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      if (!suggestOpen()) {
        // Re-open a dismissed popup without needing another keystroke.
        if (e.key === 'ArrowDown') void suggest();
        return;
      }
      e.preventDefault(); // don't move the caret / scroll the page
      const step = e.key === 'ArrowDown' ? 1 : -1;
      sgActive =
        sgActive < 0
          ? step === 1
            ? 0
            : sgRows.length - 1
          : (sgActive + step + sgRows.length) % sgRows.length;
      markActive();
    } else if (e.key === 'Enter') {
      const opts = listbox?.querySelectorAll<HTMLAnchorElement>('[role="option"]');
      const pick = suggestOpen() && sgActive >= 0 ? opts?.[sgActive] : undefined;
      if (pick) {
        e.preventDefault();
        window.location.href = pick.href;
        return;
      }
      // Enter with nothing highlighted commits the plain filter: dismiss only.
      closeSuggest();
    } else if (e.key === 'Escape') {
      // Only swallow Escape when there is a popup to dismiss, so the browser's
      // native clear-the-search-field behaviour survives otherwise.
      if (suggestOpen()) {
        e.preventDefault();
        e.stopPropagation();
        closeSuggest();
      }
    } else if (e.key === 'Tab') {
      closeSuggest();
    }
  });

  // Keep DOM focus on the input when an option is clicked, so `blur` doesn't tear
  // the popup down before the click lands on the link.
  listbox?.addEventListener('mousedown', (e) => e.preventDefault());
  search?.addEventListener('blur', () => closeSuggest());
  document.addEventListener('click', (e) => {
    if (!suggestOpen()) return;
    const target = e.target as Node | null;
    if (target && target !== search && !listbox?.contains(target)) closeSuggest();
  });

  // Typing is a `replaceState` (debounced, so keystrokes don't flood history);
  // picking a button/select/page link above is a discrete `pushState` -- one
  // Back per choice.
  let searchDebounce: ReturnType<typeof setTimeout> | undefined;
  search?.addEventListener('input', () => {
    currentPage = 1; // a filter change always lands back on page 1
    apply();
    void suggest();
    clearTimeout(searchDebounce);
    searchDebounce = setTimeout(() => writeURL(currentState(), 'replace'), 300);
  });

  // Pager links are regenerated on every apply(), so the click listener lives
  // on the (stable) container and is delegated to whichever <a data-page> was
  // clicked. Plain left-clicks are intercepted for pushState nav; a modified
  // click (new tab, etc.) is left alone -- the href is a real deep link either way.
  filterPager?.addEventListener('click', (ev) => {
    const mouseEv = ev as MouseEvent;
    if (mouseEv.defaultPrevented || mouseEv.button !== 0 || mouseEv.metaKey || mouseEv.ctrlKey || mouseEv.shiftKey || mouseEv.altKey) return;
    const link = (ev.target as HTMLElement).closest<HTMLAnchorElement>('a[data-page]');
    if (!link) return;
    const p = parseInt(link.dataset.page ?? '1', 10);
    if (!Number.isFinite(p) || p < 1) return;
    ev.preventDefault();
    currentPage = p; // NOT a filter change -- picking a page must not reset itself
    apply();
    writeURL(currentState(), 'push');
  });

  // Back/forward: re-derive state (filters AND page) from the URL (the
  // browser already restored it) and re-apply -- no history write here, it
  // would fight the navigation.
  window.addEventListener('popstate', () => {
    syncControls(stateFromURL());
    apply();
    // syncControls writes search.value directly (no input event), so the popup
    // would otherwise keep suggestions for the query we just navigated away from.
    closeSuggest();
  });

  // Deep link on first load: adopt whatever q/status/tier/category/page the
  // URL carries before the first render of the filtered grid.
  syncControls(stateFromURL());
  apply();
</script>
