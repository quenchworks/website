---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { productLabel, type VexEntry } from '../data/vex';
import { useTranslations, localizeUrl, type Lang } from '../i18n/ui';

const { lang, e } = Astro.props as { lang: Lang; e: VexEntry };
const t = useTranslations(lang);
const l = (p: string) => localizeUrl(lang, p);
// Status and justification are fixed OpenVEX enums; unknown values fall back to the raw token.
const tr = (key: string, raw: string) => (t(key as any) ?? raw.replaceAll('_', ' '));
const n = e.statements.length;
---

<Base title={`${e.name} VEX · QuenchWorks`} description={t('vex.detailDesc').replace('{name}', e.name)}>
  <Header />
  <main class="mx-auto max-w-3xl px-5 py-16" data-pagefind-body data-pagefind-meta={`title:${e.name} VEX`}>
    <p class="font-mono text-xs uppercase tracking-widest text-ash">
      <a href={l('/vex/')} class="transition-colors duration-200 hover:text-paper">VEX</a>
      <span class="text-line" aria-hidden="true"> / </span>{e.name}
    </p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">{e.name}</h1>
    <p class="mt-4 leading-relaxed text-ash">
      <span class="tabular-nums">{n}</span> {n === 1 ? t('vex.statement') : t('vex.statements')}, {t('vex.issued')} <time datetime={e.date} class="tabular-nums">{e.date}</time>.
      {t('vex.detailIntro')}
    </p>
    <div class="mt-6 flex flex-wrap gap-2 font-mono text-xs uppercase tracking-widest">
      <a href={l(`/images/${e.slug}`)} class="rounded-lg border border-line px-3.5 py-1.5 text-ash transition-colors duration-200 hover:border-paper/40 hover:text-paper">{t('vex.image')}</a>
      <a href={`/${e.path}`} class="rounded-lg border border-line px-3.5 py-1.5 text-ash transition-colors duration-200 hover:border-paper/40 hover:text-paper">{t('vex.json')}</a>
    </div>
    <p class="mt-3 break-all font-mono text-[11px] text-ash" dir="ltr">@id {e.id}</p>

    <ol class="mt-10 space-y-4">
      {e.statements.map((s) => (
        <li class="rounded-xl border border-line bg-graphite p-5">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="font-mono text-sm font-semibold text-paper" dir="ltr">{s.vulnerability.name}</h2>
            <span class="rounded border border-line px-2 py-0.5 font-mono text-[10px] uppercase tracking-widest text-ash">
              {tr(`vex.status.${s.status}`, s.status)}{s.justification ? ` · ${tr(`vex.just.${s.justification}`, s.justification)}` : ''}
            </span>
          </div>
          <ul class="mt-3 flex flex-wrap gap-1.5 font-mono text-[10px] uppercase tracking-widest text-ash" dir="ltr">
            {s.products.map((p) => <li class="rounded bg-ink px-2 py-0.5" title={p['@id']}>{productLabel(p['@id'])}</li>)}
          </ul>
          {s.impact_statement && <p class="mt-4 text-sm leading-relaxed text-ash" dir="ltr" lang="en">{s.impact_statement}</p>}
          {s.action_statement && <p class="mt-3 text-sm leading-relaxed text-ash" dir="ltr" lang="en">{s.action_statement}</p>}
        </li>
      ))}
    </ol>
  </main>
  <Footer />
</Base>
