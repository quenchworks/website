---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Pager from './Pager.astro';
import { vex, statementCount, vexPages } from '../data/vex';
import { PAGE_SIZE } from '../data/images';
import { useTranslations, localizeUrl, type Lang } from '../i18n/ui';

const { lang, current = 1 } = Astro.props as { lang: Lang; current?: number };
const t = useTranslations(lang);
const l = (p: string) => localizeUrl(lang, p);
const entries = [...vex].sort((a, b) => a.name.localeCompare(b.name));
const total = vexPages;
const slice = entries.slice((current - 1) * PAGE_SIZE, current * PAGE_SIZE);
---

<Base title={`${t('vex.title')}${current > 1 ? ` · ${current}` : ''} · QuenchWorks`} description={t('vex.metaDesc')}>
  <Header />
  <main class="mx-auto max-w-5xl px-5 py-16">
    <header class="max-w-2xl" data-pagefind-body data-pagefind-meta={`title:${t('vex.title')}`}>
      <div class="flex flex-wrap items-center gap-3">
        <p class="font-mono text-xs uppercase tracking-widest text-ash">{t('vex.kicker')}</p>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-line bg-graphite px-3 py-1 font-mono text-xs uppercase tracking-widest text-ash">
          <span class="text-base font-bold tabular-nums text-paper">{entries.length}</span> {t('vex.images')}
          <span class="text-line" aria-hidden="true">·</span>
          <span class="text-base font-bold tabular-nums text-paper">{statementCount}</span> {t('vex.statements')}
        </span>
      </div>
      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">{t('vex.title')}</h1>
      <p class="mt-4 leading-relaxed text-ash">{t('vex.intro1')}</p>
      <p class="mt-3 leading-relaxed text-ash">
        {t('vex.intro2')} <code class="font-mono text-paper" dir="ltr">@id</code>.
      </p>
    </header>

    <ul class="mt-10 grid auto-rows-fr grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {slice.map((e, i) => {
        const vulns = [...new Set(e.statements.map((s) => s.vulnerability.name))];
        return (
          <li class="card" data-reveal style={`--i:${i}`}>
            <a href={l(`/vex/${e.slug}/`)} class="group flex h-full flex-col gap-4 rounded-xl border border-line bg-graphite p-5 transition-colors duration-200 hover:border-paper/40">
              <div class="flex items-start justify-between gap-3">
                <span class="inline-flex size-10 items-center justify-center rounded-lg border border-line bg-ink">
                  <img src="/brand/icon-dark.svg" alt="" class="size-6" width="24" height="24" />
                </span>
                <span class="rounded border border-line px-2 py-0.5 font-mono text-[10px] uppercase tracking-widest text-ash">
                  <span class="text-paper tabular-nums">{e.statements.length}</span> {e.statements.length === 1 ? t('vex.statement') : t('vex.statements')}
                </span>
              </div>
              <div class="flex-1">
                <h2 class="text-base font-semibold leading-tight">{e.name}</h2>
                <p class="mt-2 line-clamp-3 font-mono text-xs leading-relaxed text-ash" dir="ltr">
                  {vulns.slice(0, 4).join(' · ')}{vulns.length > 4 ? ` · +${vulns.length - 4} ${t('vex.more')}` : ''}
                </p>
              </div>
              <p class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[10px] uppercase tracking-widest text-ash">
                <span>{t('vex.status.not_affected')}</span>
                {e.date && <><span class="text-line" aria-hidden="true">·</span><time datetime={e.date} class="tabular-nums">{e.date}</time></>}
              </p>
            </a>
          </li>
        );
      })}
    </ul>
    <Pager base={l('/vex')} current={current} total={total} />
  </main>
  <Footer />
</Base>
