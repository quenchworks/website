---
// Organizations that run QuenchWorks, from src/data/adopters.json ({ name, url }), listed only
// with their permission. Text, not logos: the system is monochrome and a name is the claim.
import adopters from '../data/adopters.json';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const list = adopters as { name: string; url: string }[];
---

<section id="adopters" class="mx-auto max-w-5xl px-5 pb-16" aria-labelledby="adopters-title">
  <h2 id="adopters-title" class="text-2xl font-semibold tracking-tight">{t('adopters.title')}</h2>
  {
    list.length > 0 ? (
      <>
        <p class="mt-3 max-w-prose text-sm leading-relaxed text-ash">{t('adopters.body')}</p>
        <ul class="mt-6 flex flex-wrap gap-3" role="list">
          {list.map((a) => (
            <li>
              <a
                href={a.url}
                rel="noopener"
                class="inline-flex rounded-lg border border-line bg-graphite px-4 py-2 text-sm font-semibold text-paper transition-colors duration-200 hover:border-paper/40"
              >
                {a.name}
              </a>
            </li>
          ))}
        </ul>
      </>
    ) : (
      <p class="mt-3 max-w-prose text-sm leading-relaxed text-ash">{t('adopters.empty')}</p>
    )
  }
  <a
    href="mailto:info@quench-works.com?subject=Add%20us%20to%20the%20QuenchWorks%20adopters"
    class="mt-6 inline-flex items-center rounded-lg border border-line px-4 py-2 text-sm font-semibold text-paper transition-colors duration-200 hover:border-paper/40"
  >
    {t('adopters.add')}
  </a>
</section>
