---
/**
 * /operators in the same browser as /charts and /stacks: CatalogList over the charts that run a
 * controller with its own CRDs (data/charts operatorCharts), 12 per page with the real pager.
 */
import CatalogList from './CatalogList.astro';
import { operatorCharts, chartTiers, PAGE_SIZE } from '../data/charts';
import { fetchArtifactHub } from '../data/artifacthub';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

interface Props {
  /** 1-based page number. */
  current: number;
}
const { current } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
const ah = await fetchArtifactHub();

const entries = [...operatorCharts].sort((a, b) => a.name.localeCompare(b.name));
const total = Math.max(1, Math.ceil(entries.length / PAGE_SIZE));
const slice = entries.slice((current - 1) * PAGE_SIZE, current * PAGE_SIZE);
const categories = [...new Set(entries.map((e) => e.category))].sort();
const tierFilters = chartTiers.map((x) => ({ key: x, label: x[0].toUpperCase() + x.slice(1) }));
---

<CatalogList
  kind="charts"
  base="/operators"
  all={entries}
  ah={ah}
  page={{ data: slice, current, total }}
  count={entries.length}
  categories={categories}
  tierFilters={tierFilters}
  pageSize={PAGE_SIZE}
  view={{ type: t('operators.type'), noun: t('operators.count'), title: t('operators.title'), lede: t('operators.desc') }}
/>
