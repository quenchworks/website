---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CatalogList from '../../../components/CatalogList.astro';
import { listedCharts as charts, eolCharts, chartCount, chartTiers, PAGE_SIZE } from '../../../data/charts';
import { fetchArtifactHub } from '../../../data/artifacthub';

// live chart + app versions at build time; falls back gracefully if AH is unreachable.
const ah = await fetchArtifactHub();

const entries = [...eolCharts].sort((a, b) => a.name.localeCompare(b.name));
const categories = [...new Set(eolCharts.map((e) => e.category))].sort();
const tierFilters = chartTiers.map((t) => ({ key: t, label: t[0].toUpperCase() + t.slice(1) }));

// End-of-life tab: every EOL entry on one page, next to the supported list at /es/charts.
const total = 1;
const slice = entries;
---

<Base
  title="Charts sin soporte · QuenchWorks"
  description="QuenchWorks charts that are no longer updated, kept downloadable with their pages and the replacement named."
>
  <Header />
  <main class="mx-auto max-w-5xl px-5 py-16">
    <CatalogList
      kind="charts"
      base="/charts"
      all={entries}
      ah={ah}
      page={{ data: slice, current: 1, total }}
      count={eolCharts.length}
      categories={categories}
      tierFilters={tierFilters}
      pageSize={PAGE_SIZE}
      tab="eol"
      eolCount={eolCharts.length}
    />
  </main>
  <Footer />
</Base>
