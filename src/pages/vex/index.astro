---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { vex, statementCount } from '../../data/vex';

const entries = [...vex].sort((a, b) => a.name.localeCompare(b.name));
---

<Base
  title="VEX · QuenchWorks"
  description="Every OpenVEX statement QuenchWorks ships: which scanner findings are not exploitable in an image, and the file-level evidence for each."
>
  <Header />
  <main class="mx-auto max-w-5xl px-5 py-16">
    <header class="max-w-2xl" data-pagefind-body data-pagefind-meta="title:VEX statements">
      <div class="flex flex-wrap items-center gap-3">
        <p class="font-mono text-xs uppercase tracking-widest text-ash">OpenVEX</p>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-line bg-graphite px-3 py-1 font-mono text-xs uppercase tracking-widest text-ash">
          <span class="text-base font-bold tabular-nums text-paper">{entries.length}</span> images
          <span class="text-line" aria-hidden="true">·</span>
          <span class="text-base font-bold tabular-nums text-paper">{statementCount}</span> statements
        </span>
      </div>
      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">VEX statements</h1>
      <p class="mt-4 leading-relaxed text-ash">
        A scanner reports every vulnerable package version it can see. Sometimes the vulnerable code is not
        in the image at all, or nothing can reach it. A VEX statement records that, with the evidence: the
        file, the build flag or the call path that rules the finding out.
      </p>
      <p class="mt-3 leading-relaxed text-ash">
        Each statement is checked before Trivy may honour it, so a VEX can never hide a finding without proof.
        Anything that is fixable gets fixed instead. Every document below is also served as raw OpenVEX JSON at
        its own <code class="font-mono text-paper">@id</code>.
      </p>
    </header>

    <ul class="mt-10 grid auto-rows-fr grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {entries.map((e, i) => {
        const vulns = [...new Set(e.statements.map((s) => s.vulnerability.name))];
        return (
          <li class="card" data-reveal style={`--i:${i}`}>
            <a href={`/vex/${e.slug}/`} class="group flex h-full flex-col gap-4 rounded-xl border border-line bg-graphite p-5 transition-colors duration-200 hover:border-paper/40">
              <div class="flex items-start justify-between gap-3">
                <span class="inline-flex size-10 items-center justify-center rounded-lg border border-line bg-ink">
                  <img src="/brand/icon-dark.svg" alt="" class="size-6" width="24" height="24" />
                </span>
                <span class="rounded border border-line px-2 py-0.5 font-mono text-[10px] uppercase tracking-widest text-ash">
                  <span class="text-paper tabular-nums">{e.statements.length}</span> {e.statements.length === 1 ? 'statement' : 'statements'}
                </span>
              </div>
              <div class="flex-1">
                <h2 class="text-base font-semibold leading-tight">{e.name}</h2>
                <p class="mt-2 line-clamp-3 font-mono text-xs leading-relaxed text-ash">
                  {vulns.slice(0, 4).join(' · ')}{vulns.length > 4 ? ` · +${vulns.length - 4} more` : ''}
                </p>
              </div>
              <p class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[10px] uppercase tracking-widest text-ash">
                <span>not affected</span>
                {e.date && <><span class="text-line" aria-hidden="true">·</span><time datetime={e.date} class="tabular-nums">{e.date}</time></>}
              </p>
            </a>
          </li>
        );
      })}
    </ul>
  </main>
  <Footer />
</Base>
