---
import VexDetail from '../../../../components/VexDetail.astro';
import { vex, type VexEntry } from '../../../../data/vex';

export const getStaticPaths = () => vex.map((e) => ({ params: { slug: e.slug }, props: { e } }));
const { e } = Astro.props as { e: VexEntry };
---

<VexDetail lang="ar" e={e} />
