---
import Base from '../../../../layouts/Base.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import OperatorCatalog from '../../../../components/OperatorCatalog.astro';
import { operatorCharts, PAGE_SIZE } from '../../../../data/charts';
import { useTranslations } from '../../../../i18n/ui';

// Pages 2..N; page 1 is /operators.
export function getStaticPaths() {
  const total = Math.max(1, Math.ceil(operatorCharts.length / PAGE_SIZE));
  return Array.from({ length: total - 1 }, (_, i) => ({ params: { page: String(i + 2) }, props: { current: i + 2 } }));
}
const { current } = Astro.props;
const t = useTranslations('ar');
---

<Base title={`${t('operators.type')} · ${current} · QuenchWorks`} description={t('operators.desc')}>
  <Header />
  <main class="mx-auto max-w-5xl px-5 py-16">
    <OperatorCatalog current={current} />
  </main>
  <Footer />
</Base>
