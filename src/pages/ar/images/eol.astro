---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CatalogList from '../../../components/CatalogList.astro';
import { listedImages as images, eolImages, availableCount, imageTiers, PAGE_SIZE } from '../../../data/images';
import { fetchArtifactHub } from '../../../data/artifacthub';

// live image (app) versions at build time; falls back gracefully if AH is unreachable.
const ah = await fetchArtifactHub();

const entries = [...eolImages].sort((a, b) => {
  if (a.status !== b.status) return a.status === 'available' ? -1 : 1;
  return a.name.localeCompare(b.name);
});

const categories = [...new Set(eolImages.map((e) => e.category))].sort();
const tierFilters = imageTiers.map((t) => ({ key: t, label: t[0].toUpperCase() + t.slice(1) }));

// End-of-life tab: every EOL entry on one page, next to the supported list at /ar/images.
const total = 1;
const slice = entries;
---

<Base
  title="صور منتهية الدعم · QuenchWorks"
  description="QuenchWorks images that are no longer updated, kept downloadable with their pages and the replacement named."
>
  <Header />
  <main class="mx-auto max-w-5xl px-5 py-16">
    <CatalogList
      kind="images"
      base="/images"
      all={entries}
      ah={ah}
      page={{ data: slice, current: 1, total }}
      count={eolImages.length}
      categories={categories}
      tierFilters={tierFilters}
      pageSize={PAGE_SIZE}
      tab="eol"
      eolCount={eolImages.length}
    />
  </main>
  <Footer />
</Base>
