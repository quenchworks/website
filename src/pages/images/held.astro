---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CatalogList from '../../components/CatalogList.astro';
import { listedImages as images, heldImages, eolImages, availableCount, imageTiers, PAGE_SIZE } from '../../data/images';
import { fetchArtifactHub } from '../../data/artifacthub';

// live image (app) versions at build time; falls back gracefully if AH is unreachable.
const ah = await fetchArtifactHub();

const entries = [...heldImages].sort((a, b) => {
  if (a.status !== b.status) return a.status === 'available' ? -1 : 1;
  return a.name.localeCompare(b.name);
});

const categories = [...new Set(heldImages.map((e) => e.category))].sort();
const tierFilters = imageTiers.map((t) => ({ key: t, label: t[0].toUpperCase() + t.slice(1) }));

// Held tab: every held entry on one page, next to the supported list at /images.
const total = 1;
const slice = entries;
---

<Base
  title="Held images · QuenchWorks"
  description="QuenchWorks images held back until an upstream fix ships, still downloadable, each page naming the blocker."
>
  <Header />
  <main class="mx-auto max-w-5xl px-5 py-16">
    <CatalogList
      kind="images"
      base="/images"
      all={entries}
      ah={ah}
      page={{ data: slice, current: 1, total }}
      count={heldImages.length}
      categories={categories}
      tierFilters={tierFilters}
      pageSize={PAGE_SIZE}
      tab="held"
      eolCount={eolImages.length} heldCount={heldImages.length}
    />
  </main>
  <Footer />
</Base>
