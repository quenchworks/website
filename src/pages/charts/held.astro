---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CatalogList from '../../components/CatalogList.astro';
import { listedCharts as charts, heldCharts, eolCharts, chartCount, chartTiers, PAGE_SIZE } from '../../data/charts';
import { fetchArtifactHub } from '../../data/artifacthub';

// live chart + app versions at build time; falls back gracefully if AH is unreachable.
const ah = await fetchArtifactHub();

const entries = [...heldCharts].sort((a, b) => a.name.localeCompare(b.name));
const categories = [...new Set(heldCharts.map((e) => e.category))].sort();
const tierFilters = chartTiers.map((t) => ({ key: t, label: t[0].toUpperCase() + t.slice(1) }));

// Held tab: every held entry on one page, next to the supported list at /charts.
const total = 1;
const slice = entries;
---

<Base
  title="Held charts · QuenchWorks"
  description="QuenchWorks charts held back until an upstream fix ships, still installable, each page naming the blocker."
>
  <Header />
  <main class="mx-auto max-w-5xl px-5 py-16">
    <CatalogList
      kind="charts"
      base="/charts"
      all={entries}
      ah={ah}
      page={{ data: slice, current: 1, total }}
      count={heldCharts.length}
      categories={categories}
      tierFilters={tierFilters}
      pageSize={PAGE_SIZE}
      tab="held"
      eolCount={eolCharts.length} heldCount={heldCharts.length}
    />
  </main>
  <Footer />
</Base>
